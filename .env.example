FLASK_ENV=development
SECRET_KEY=REPLACE_ME

# Database: use SQLite by default; override in production
DATABASE_URL=sqlite:///zakat360_dev.db

# File uploads
UPLOAD_DIR=./zakat360/static/uploads

# Metals API (optional)
METALS_API_URL=https://api.example.com/metals
METALS_API_KEY=REPLACE_ME
FX_RATE_MAD=10

# Google OAuth (optional)
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration